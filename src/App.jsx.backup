/* =========================
   SHIPMENT APPROVE (تأیید مالی)
========================= */

function ShipmentApprove({ currentUser, showToast, setPage, handleLogout, darkMode, setDarkMode }) {
  const [exits, setExits] = useState([])
  const [selectedExit, setSelectedExit] = useState(null)
  const [rejectExit, setRejectExit] = useState(null)

  const [paymentForm, setPaymentForm] = useState({
    payment_type: "",
    payment_notes: ""
  })

  const [rejectReason, setRejectReason] = useState("")

  // =======================
  // بارگذاری
  // =======================
  const loadExits = () => {
    authFetch("/api/exits")
      .then((res) => res.json())
      .then((data) => setExits(Array.isArray(data) ? data : []))
      .catch((error) => console.error("خطا در دریافت خروجی‌ها:", error))
  }

  useEffect(() => {
    loadExits()
  }, [])

  const pendingExits = exits.filter((e) => e.status === "pending" || !e.status)

  // =======================
  // تأیید مالی
  // =======================
  const handleApprove = async () => {
    if (!paymentForm.payment_type) {
      showToast("نوع پرداخت رو انتخاب کن", "warning")
      return
    }

    try {
      const response = await authFetch(
        `/api/exits/${selectedExit.id}/approve`,
        {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(paymentForm)
        }
      )
      const data = await response.json()

      if (data.success) {
        showToast("✅ خروجی تأیید مالی شد", "success")
        setSelectedExit(null)
        setPaymentForm({ payment_type: "", payment_notes: "" })
        loadExits()
      } else {
        showToast(data.message || "خطا در تأیید", "error")
      }
    } catch (error) {
      console.error(error)
      showToast("خطا در ارتباط با سرور", "error")
    }
  }

  // =======================
  // رد خروجی
  // =======================
  const handleReject = async () => {
    if (!rejectReason.trim()) {
      showToast("دلیل رد رو وارد کن", "warning")
      return
    }

    try {
      const response = await authFetch(
        `/api/exits/${rejectExit.id}/reject`,
        {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ reject_reason: rejectReason })
        }
      )
      const data = await response.json()

      if (data.success) {
        showToast("خروجی رد شد", "success")
        setRejectExit(null)
        setRejectReason("")
        loadExits()
      } else {
        showToast(data.message || "خطا در رد", "error")
      }
    } catch (error) {
      console.error(error)
      showToast("خطا در ارتباط با سرور", "error")
    }
  }

  return (
    <>
      <header className="topbar">
        <div>
          <h1>تأیید مالی خروجی</h1>
          <p>بررسی و تأیید مالی خروجی‌های ثبت‌شده</p>
        </div>
        
      </header>

      <div className="panel">
        <div className="panel-header">
          <h2>⏳ خروجی‌های در انتظار تأیید مالی</h2>
          <span>{pendingExits.length} درخواست</span>
        </div>

        {pendingExits.length === 0 ? (
          <div className="empty-state">
            <div>✅</div>
            <h3>همه خروجی‌ها تأیید شدن</h3>
            <p>درخواست جدیدی برای تأیید وجود نداره.</p>
          </div>
        ) : (
          <div className="orders-table-wrapper">
            <table className="orders-table">
              <thead>
                <tr>
                  <th>ردیف</th>
                  <th>تاریخ خروج</th>
                  <th>مشتری</th>
                  <th>دسته</th>
                  <th>محصول</th>
                  <th>مقدار</th>
                  <th>واحد</th>
                  <th>ثبت‌کننده</th>
                  <th>عملیات</th>
                </tr>
              </thead>
              <tbody>
                {pendingExits.map((ex, index) => (
                  <tr key={ex.id}>
                    <td><span className="row-number">{index + 1}</span></td>
                    <td><span className="date-badge">📅 {toPersianDate(ex.exit_date)}</span></td>
                    <td><span className="customer-name">{ex.customer_name}</span></td>
                    <td><span className="machine-badge">{ex.category || "-"}</span></td>
                    <td>{ex.product_name}</td>
                    <td><span className="weight-badge">{Number(ex.quantity || 0).toLocaleString()}</span></td>
                    <td>{ex.unit || "عدد"}</td>
                    <td><span className="notes-text">👤 {ex.created_by || "-"}</span></td>
                    <td>
                      <div className="row-actions">
                                       <button
                          className="save-btn"
                          style={{
                            padding: "8px 16px",
                            fontSize: "12px",
                            background: "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                            color: "#ffffff",
                            fontWeight: 700,
                            border: "none",
                            borderRadius: "10px",
                            cursor: "pointer",
                            boxShadow: "0 4px 12px rgba(16, 185, 129, 0.35)",
                            transition: "all 0.25s ease"
                          }}
                          onClick={() => {
                            setSelectedExit(ex)
                            setPaymentForm({ payment_type: "", payment_notes: "" })
                          }}
                        >
                          ✅ تأیید مالی
                        </button>
                        <button
                          className="row-btn delete-btn"
                          title="رد"
                          onClick={() => setRejectExit(ex)}
                        >
                          ❌
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      {/* مودال تأیید مالی */}
      {selectedExit && (
        <div className="modal-overlay" onClick={() => setSelectedExit(null)}>
          <div className="modal-box" onClick={(e) => e.stopPropagation()}>
            <div className="modal-header">
              <h2>✅ تأیید مالی - {selectedExit.customer_name}</h2>
              <button className="modal-close" onClick={() => setSelectedExit(null)}>✕</button>
            </div>

            <div style={{ padding: "20px" }}>
              <div className="final-summary-section">
                <h3>📋 اطلاعات خروجی</h3>
                <div className="summary-grid">
                  <div><span>تاریخ خروج:</span><strong>{toPersianDate(selectedExit.exit_date)}</strong></div>
                  <div><span>مشتری:</span><strong>{selectedExit.customer_name}</strong></div>
                  <div><span>دسته:</span><strong>{selectedExit.category || "-"}</strong></div>
                  <div><span>محصول:</span><strong>{selectedExit.product_name}</strong></div>
                  <div><span>مقدار:</span><strong>{Number(selectedExit.quantity || 0).toLocaleString()} {selectedExit.unit || "عدد"}</strong></div>
                  <div><span>ثبت‌کننده:</span><strong>{selectedExit.created_by || "-"}</strong></div>
                </div>
              </div>

              <div className="form-grid" style={{ marginTop: "20px" }}>
                <div className="form-group full-width">
                  <label>💳 نوع پرداخت</label>
                  <select
                    value={paymentForm.payment_type}
                    onChange={(e) => setPaymentForm({ ...paymentForm, payment_type: e.target.value })}
                    className="filter-select-pretty"
                    required
                  >
                    <option value="">انتخاب نوع پرداخت</option>
                    <option value="نقدی">نقدی</option>
                    <option value="چکی">چکی</option>
                    <option value="کارت به کارت">کارت به کارت</option>
                    <option value="اعتباری">اعتباری</option>
                    <option value="تسویه شده">تسویه شده</option>
                  </select>
                </div>

                <div className="form-group full-width">
                  <label>📝 توضیحات مالی</label>
                  <textarea
                    value={paymentForm.payment_notes}
                    onChange={(e) => setPaymentForm({ ...paymentForm, payment_notes: e.target.value })}
                    placeholder="توضیحات مربوط به پرداخت..."
                    rows={3}
                  ></textarea>
                </div>
              </div>

              <div className="form-actions">
                <button
                  type="button"
                  className="cancel-btn"
                  onClick={() => setSelectedExit(null)}
                >
                  انصراف
                </button>
                         <button
                  type="button"
                  className="save-btn"
                  onClick={handleApprove}
                  style={{
                    background: "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                    color: "#ffffff",
                    fontWeight: 700,
                    padding: "12px 28px",
                    border: "none",
                    borderRadius: "12px",
                    cursor: "pointer",
                    boxShadow: "0 6px 18px rgba(16, 185, 129, 0.4)",
                    display: "flex",
                    alignItems: "center",
                    gap: "8px",
                    transition: "all 0.25s ease"
                  }}
                >
                  ✅ تأیید مالی
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* مودال رد */}
      {rejectExit && (
        <div className="modal-overlay" onClick={() => setRejectExit(null)}>
          <div className="modal-box delete-modal" onClick={(e) => e.stopPropagation()}>
            <div className="delete-modal-icon">❌</div>
            <h2>رد خروجی</h2>
            <p>
              آیا مطمئنی می‌خوای خروجی <strong>{rejectExit.customer_name}</strong> رو رد کنی؟
            </p>

            <div className="form-group" style={{ marginTop: "15px", textAlign: "right" }}>
              <label>دلیل رد</label>
              <textarea
                value={rejectReason}
                onChange={(e) => setRejectReason(e.target.value)}
                placeholder="دلیل رد خروجی..."
                rows={3}
                style={{
                  width: "100%",
                  padding: "12px",
                  borderRadius: "10px",
                  border: "1.5px solid #e5e7eb",
                  fontFamily: "inherit"
                }}
              ></textarea>
            </div>

            <div className="delete-modal-actions">
              <button className="cancel-btn" onClick={() => setRejectExit(null)}>
                انصراف
              </button>
              <button className="confirm-delete-btn" onClick={handleReject}>
                ❌ رد کن
              </button>
            </div>
          </div>
        </div>
      )}
    </>
  )
}
/* =========================
   SHIPMENT REPORT (گزارش خروجی جدید)
========================= */

function ShipmentReport({ currentUser, setPage, handleLogout, darkMode, setDarkMode }) {
  const [exits, setExits] = useState([])
  const [selectedExitDetail, setSelectedExitDetail] = useState(null)
  const [deleteExit, setDeleteExit] = useState(null)

  const [filterStatus, setFilterStatus] = useState("")
  const [filterCustomer, setFilterCustomer] = useState("")
  const [searchTerm, setSearchTerm] = useState("")
  const [filterFrom, setFilterFrom] = useState("")
  const [filterTo, setFilterTo] = useState("")

  const [currentPage, setCurrentPage] = useState(1)
  const [perPage, setPerPage] = useState(10)
  const [sortOrder, setSortOrder] = useState("newest")
const [deleteConfirm, setDeleteConfirm] = useState(null)
  const loadExits = () => {
    authFetch("/api/exits")
      .then((res) => res.json())
      .then((data) => setExits(Array.isArray(data) ? data : []))
      .catch((error) => console.error("خطا در دریافت خروجی‌ها:", error))
  }

  useEffect(() => {
    loadExits()
  }, [])

  const filteredExits = exits.filter((e) => {
    if (filterStatus && e.status !== filterStatus) return false
    if (filterCustomer && e.customer_name !== filterCustomer) return false
    if (filterFrom && e.exit_date < filterFrom) return false
    if (filterTo && e.exit_date > filterTo) return false

    if (searchTerm) {
      const term = searchTerm.toLowerCase()
      const matchCustomer = e.customer_name?.toLowerCase().includes(term)
      const matchProduct = e.product_name?.toLowerCase().includes(term)
      const matchCategory = e.category?.toLowerCase().includes(term)
      const matchDate = toPersianDate(e.exit_date).includes(searchTerm) || e.exit_date?.includes(searchTerm)
      if (!matchCustomer && !matchProduct && !matchCategory && !matchDate) return false
    }

    return true
  })

  const sortedExits = [...filteredExits].sort((a, b) => {
    const dateA = a.exit_date || ""
    const dateB = b.exit_date || ""
    return sortOrder === "newest"
      ? dateB.localeCompare(dateA)
      : dateA.localeCompare(dateB)
  })

  const totalPages = Math.ceil(sortedExits.length / perPage)
  const startIndex = (currentPage - 1) * perPage
  const currentExits = sortedExits.slice(startIndex, startIndex + perPage)

  useEffect(() => {
    if (currentPage > totalPages) {
      setCurrentPage(1)
    }
  }, [currentPage, totalPages])

  const handleClear = () => {
    setFilterStatus("")
    setFilterCustomer("")
    setSearchTerm("")
    setFilterFrom("")
    setFilterTo("")
    setCurrentPage(1)
  }

  const handleDeleteExit = async () => {
    if (!deleteExit) return

    try {
      const response = await authFetch(
        `/api/exits/${deleteExit.id}`,
        { method: "DELETE" }
      )
      const data = await response.json()

      if (data.success) {
        setDeleteExit(null)
        loadExits()
      }
    } catch (error) {
      console.error(error)
      setDeleteExit(null)
    }
  }

  const getStatusBadge = (status) => {
    if (status === "pending" || !status) return { text: "⏳ در انتظار تأیید مالی", class: "status-pending" }
    if (status === "approved") return { text: "✅ تأیید مالی شده", class: "status-approved" }
    if (status === "rejected") return { text: "❌ رد شده", class: "status-rejected" }
    return { text: status, class: "" }
  }

  const uniqueCustomers = [...new Set(exits.map((e) => e.customer_name))]

  const totalQuantity = filteredExits.reduce((sum, e) => sum + Number(e.quantity || 0), 0)
  const approvedCount = filteredExits.filter((e) => e.status === "approved").length
  const pendingCount = filteredExits.filter((e) => !e.status || e.status === "pending").length

  return (
    <>
      <header className="topbar">
        <div>
          <h1>گزارش خروجی</h1>
          <p>مشاهده و جستجوی همه خروجی‌های ثبت‌شده</p>
        </div>
        
      </header>

      <section className="stats">
        <div className="stat-card">
          <div className="stat-icon"><span>📤</span></div>
          <div>
            <span>کل خروجی‌ها</span>
            <strong>{filteredExits.length}</strong>
            <small>رکورد</small>
          </div>
        </div>

        <div className="stat-card">
          <div className="stat-icon"><span>✅</span></div>
          <div>
            <span>تأیید مالی شده</span>
            <strong>{approvedCount}</strong>
            <small>خروجی</small>
          </div>
        </div>

        <div className="stat-card">
          <div className="stat-icon"><span>⏳</span></div>
          <div>
            <span>در انتظار تأیید</span>
            <strong>{pendingCount}</strong>
            <small>خروجی</small>
          </div>
        </div>

        <div className="stat-card">
          <div className="stat-icon"><span>🔢</span></div>
          <div>
            <span>جمع مقادیر</span>
            <strong>{totalQuantity.toLocaleString()}</strong>
            <small>واحد</small>
          </div>
        </div>
      </section>

         <div className="panel" style={{ position: "relative", zIndex: 100 }}>
        <div className="panel-header">
          <h2>🔍 فیلترها</h2>
          <span>جستجو و فیلتر خروجی‌ها</span>
        </div>

        <div className="search-bar-wrapper" style={{ maxWidth: "100%", marginBottom: "18px" }}>
          <span className="search-bar-icon">🔍</span>
          <input
            type="text"
            placeholder="جستجو در مشتری، محصول، دسته..."
            value={searchTerm}
            onChange={(e) => {
              setSearchTerm(e.target.value)
              setCurrentPage(1)
            }}
            className="search-bar-input"
          />
          {searchTerm && (
            <button
              className="search-bar-clear"
              onClick={() => setSearchTerm("")}
            >
              ✕
            </button>
          )}
        </div>

        <div className="filter-row">
          <div className="filter-item">
            <span className="filter-label">📊 وضعیت</span>
            <select
              value={filterStatus}
              onChange={(e) => {
                setFilterStatus(e.target.value)
                setCurrentPage(1)
              }}
              className="filter-select-pretty"
            >
              <option value="">همه وضعیت‌ها</option>
              <option value="pending">⏳ در انتظار تأیید</option>
              <option value="approved">✅ تأیید مالی شده</option>
              <option value="rejected">❌ رد شده</option>
            </select>
          </div>

          <div className="filter-item">
            <span className="filter-label">👤 مشتری</span>
            <CustomerSearchSelect
              customers={uniqueCustomers.map((name, i) => ({ id: i, name }))}
              value={filterCustomer}
              onChange={(name) => {
                setFilterCustomer(name)
                setCurrentPage(1)
              }}
            />
          </div>

          <div className="filter-item">
            <span className="filter-label">📅 از تاریخ</span>
            <PersianDateInput
              value={filterFrom}
              onChange={(date) => {
                setFilterFrom(date)
                setCurrentPage(1)
              }}
              placeholder="از تاریخ"
            />
          </div>

          <div className="filter-item">
            <span className="filter-label">📅 تا تاریخ</span>
            <PersianDateInput
              value={filterTo}
              onChange={(date) => {
                setFilterTo(date)
                setCurrentPage(1)
              }}
              placeholder="تا تاریخ"
            />
          </div>

          <button
            type="button"
            className="clear-filter-btn"
            onClick={handleClear}
          >
            🔄 پاک کردن
          </button>
        </div>

              <div className="quick-filters" style={{ position: "relative", zIndex: 1 }}>
          <span className="quick-filters-label">⚡ فیلتر سریع:</span>
          <button
            type="button"
            className={`quick-filter-btn ${filterStatus === "pending" ? "active" : ""}`}
            onClick={() => {
              setFilterStatus(filterStatus === "pending" ? "" : "pending")
              setCurrentPage(1)
            }}
          >
            ⏳ در انتظار
          </button>
          <button
            type="button"
            className={`quick-filter-btn ${filterStatus === "approved" ? "active" : ""}`}
            onClick={() => {
              setFilterStatus(filterStatus === "approved" ? "" : "approved")
              setCurrentPage(1)
            }}
          >
            ✅ تأیید شده
          </button>
          <button
            type="button"
            className={`quick-filter-btn ${filterStatus === "rejected" ? "active" : ""}`}
            onClick={() => {
              setFilterStatus(filterStatus === "rejected" ? "" : "rejected")
              setCurrentPage(1)
            }}
          >
            ❌ رد شده
          </button>
        </div>
      </div>

      <div className="panel" style={{ position: "relative", zIndex: 1 }}>
        <div className="panel-header">
          <h2>📋 لیست خروجی‌ها</h2>
          <span>{filteredExits.length} رکورد</span>
        </div>
        {filteredExits.length === 0 ? (
          <div className="empty-state">
            <div>📤</div>
            <h3>خروجی‌ای پیدا نشد</h3>
            <p>با این فیلترها خروجی‌ای وجود نداره.</p>
          </div>
        ) : (
          <>
            <TableControls
              totalItems={filteredExits.length}
              perPage={perPage}
              onPerPageChange={setPerPage}
              sortOrder={sortOrder}
              onSortChange={setSortOrder}
            />

            <div className="orders-table-wrapper">
              <table className="orders-table">
                <thead>
                  <tr>
                    <th>ردیف</th>
                    <th>تاریخ خروج</th>
                    <th>مشتری</th>
                    <th>دسته</th>
                    <th>محصول</th>
                    <th>مقدار</th>
                    <th>واحد</th>
                    <th>وضعیت</th>
                    <th>نوع پرداخت</th>
                    <th>ثبت‌کننده</th>
                    <th>عملیات</th>
                  </tr>
                </thead>
                <tbody>
                  {currentExits.map((e, index) => {
                    const statusBadge = getStatusBadge(e.status)
                    return (
                      <tr key={e.id}>
                        <td>{startIndex + index + 1}</td>
                        <td>
                          <span className="date-badge">
                            📅 {toPersianDate(e.exit_date)}
                          </span>
                        </td>
                        <td><span className="customer-name">{e.customer_name}</span></td>
                        <td><span className="machine-badge">{e.category || "-"}</span></td>
                        <td>{e.product_name}</td>
                        <td>
                          <span className="weight-badge">
                            {Number(e.quantity || 0).toLocaleString()}
                          </span>
                        </td>
                        <td>{e.unit || "عدد"}</td>
                        <td>
                          <span className={`status-badge ${statusBadge.class}`}>
                            {statusBadge.text}
                          </span>
                        </td>
                        <td>
                          {e.payment_type ? (
                            <span className="machine-badge">💳 {e.payment_type}</span>
                          ) : (
                            "-"
                          )}
                        </td>
                        <td>
                          <span className="notes-text">👤 {e.created_by || "-"}</span>
                        </td>
                        <td>
                          <div className="row-actions">
                            <button
                              type="button"
                              className="row-btn edit-btn"
                              title="جزئیات"
                              onClick={() => setSelectedExitDetail(e)}
                            >
                              👁️
                            </button>

                            {currentUser?.role === "admin" && (
                              <button
                                type="button"
                                className="row-btn delete-btn"
                                title="حذف"
                                onClick={() => setDeleteExit(e)}
                              >
                                🗑️
                              </button>
                            )}
                          </div>
                        </td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>

            <Pagination
              currentPage={currentPage}
              totalPages={totalPages}
              onPageChange={setCurrentPage}
            />
          </>
        )}
      </div>

      {selectedExitDetail && (
        <div className="modal-overlay" onClick={() => setSelectedExitDetail(null)}>
          <div
            className="modal-box"
            onClick={(e) => e.stopPropagation()}
            style={{ maxWidth: "700px", maxHeight: "90vh", overflowY: "auto" }}
          >
            <div className="print-header">
              <img src="/logo.jpg" alt="آجر نسوز و نما" className="print-logo" />
              <div className="print-header-info">
                <h1>شرکت آجر نسوز و نما محراب</h1>
                <p>رسید خروج کالا</p>
              </div>
              <div className="print-header-date">
                <span>تاریخ پرینت:</span>
                <strong>{toPersianDate(new Date().toISOString().split("T")[0])}</strong>
              </div>
            </div>

            <div className="modal-header">
              <h2>📋 جزئیات خروجی - {selectedExitDetail.customer_name}</h2>
              <div style={{ display: "flex", gap: "10px", alignItems: "center" }}>
                <button
                  type="button"
                  className="save-btn"
                  style={{ padding: "8px 16px", fontSize: "13px" }}
                  onClick={() => window.print()}
                >
                  🖨️ پرینت / PDF
                </button>
                <button
                  className="modal-close"
                  onClick={() => setSelectedExitDetail(null)}
                >
                  ✕
                </button>
              </div>
            </div>

            <div className="final-summary-section">
              <h3>📋 مشخصات کلی</h3>
              <div className="summary-grid">
                <div><span>تاریخ خروج:</span><strong>{toPersianDate(selectedExitDetail.exit_date)}</strong></div>
                <div><span>مشتری:</span><strong>{selectedExitDetail.customer_name}</strong></div>
                <div><span>دسته:</span><strong>{selectedExitDetail.category || "-"}</strong></div>
                <div><span>محصول:</span><strong>{selectedExitDetail.product_name}</strong></div>
                <div><span>مقدار:</span><strong>{Number(selectedExitDetail.quantity || 0).toLocaleString()} {selectedExitDetail.unit || "عدد"}</strong></div>
                <div><span>ثبت‌کننده:</span><strong>{selectedExitDetail.created_by || "-"}</strong></div>
                <div><span>وضعیت:</span><strong>{getStatusBadge(selectedExitDetail.status).text}</strong></div>
                <div><span>نوع پرداخت:</span><strong>{selectedExitDetail.payment_type || "-"}</strong></div>
                <div><span>تأییدکننده مالی:</span><strong>{selectedExitDetail.approved_by || "-"}</strong></div>
              </div>
            </div>

            {selectedExitDetail.payment_notes && (
              <div className="final-summary-section">
                <h3>💳 توضیحات مالی</h3>
                <p style={{ margin: 0, lineHeight: "1.8" }}>{selectedExitDetail.payment_notes}</p>
              </div>
            )}

            {selectedExitDetail.notes && (
              <div className="final-summary-section">
                <h3>📝 توضیحات</h3>
                <p style={{ margin: 0, lineHeight: "1.8" }}>{selectedExitDetail.notes}</p>
              </div>
            )}

            {selectedExitDetail.status === "rejected" && selectedExitDetail.reject_reason && (
              <div className="final-summary-section" style={{ background: "rgba(254, 226, 226, 0.4)" }}>
                <h3>❌ دلیل رد</h3>
                <p style={{ margin: 0, lineHeight: "1.8", color: "#b91c1c" }}>
                  {selectedExitDetail.reject_reason}
                </p>
              </div>
            )}
          </div>
        </div>
      )}

      {deleteExit && (
        <div className="modal-overlay" onClick={() => setDeleteExit(null)}>
          <div className="modal-box delete-modal" onClick={(e) => e.stopPropagation()}>
            <div className="delete-modal-icon">🗑️</div>
            <h2>حذف خروجی</h2>
            <p>
              آیا مطمئنی می‌خوای خروجی <strong>{deleteExit.customer_name}</strong> رو حذف کنی؟
              <br />
              <strong>این عمل قابل بازگشت نیست.</strong>
            </p>

            <div className="delete-modal-actions">
              <button className="cancel-btn" onClick={() => setDeleteExit(null)}>
                انصراف
              </button>
              <button className="confirm-delete-btn" onClick={handleDeleteExit}>
                🗑️ بله، حذف کن
              </button>
            </div>
          </div>
        </div>
      )}
    </>
  )
}

/* =========================
   BACKUP PAGE
========================= */

function BackupPage({ showToast, currentUser, setPage, handleLogout, darkMode, setDarkMode }) {
  const [backups, setBackups] = useState([])
  const [loading, setLoading] = useState(false)
  const [creating, setCreating] = useState(false)

  const loadBackups = () => {
    setLoading(true)
    authFetch("/api/backup/list")
      .then((res) => res.json())
      .then((data) => {
        setBackups(data)
        setLoading(false)
      })
      .catch((error) => {
        console.error(error)
        setLoading(false)
      })
  }

  useEffect(() => {
    loadBackups()
  }, [])

  const handleCreate = async () => {
    setCreating(true)
    try {
      const response = await authFetch("/api/backup/create", {
        method: "POST"
      })
      const data = await response.json()

      if (data.success) {
        showToast("بک‌آپ با موفقیت گرفته شد", "success")
        loadBackups()
      } else {
        showToast(data.message || "خطا در بک‌آپ", "error")
      }
    } catch (error) {
      console.error(error)
      showToast("خطا در ارتباط با سرور", "error")
    } finally {
      setCreating(false)
    }
  }

  const handleDownload = (fileName) => {
    window.open(`/api/backup/download/${fileName}`, "_blank")
  }

  const handleDelete = async (fileName) => {
    if (!window.confirm("آیا از حذف این بک‌آپ مطمئنی؟")) return

    try {
      const response = await authFetch(`/api/backup/${fileName}`, {
        method: "DELETE"
      })
      const data = await response.json()

      if (data.success) {
        showToast("بک‌آپ حذف شد", "success")
        loadBackups()
      } else {
        showToast(data.message || "خطا در حذف", "error")
      }
    } catch (error) {
      console.error(error)
      showToast("خطا در حذف", "error")
    }
  }

  const formatSize = (bytes) => {
    if (bytes < 1024) return bytes + " B"
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB"
    return (bytes / (1024 * 1024)).toFixed(1) + " MB"
  }

  return (
    <>
      <header className="topbar">
        <div>
          <h1>💾 بک‌آپ‌گیری</h1>
          <p>مدیریت نسخه‌های پشتیبان دیتابیس</p>
        </div>
             
      </header>

      <div className="panel">
        <div className="panel-header">
          <h2>📸 گرفتن بک‌آپ جدید</h2>
        </div>

        <div style={{ padding: "20px", textAlign: "center" }}>
          <p style={{ marginBottom: "20px", color: "#6b7280" }}>
            با زدن این دکمه، یه نسخه پشتیبان از دیتابیس فعلی گرفته میشه.
          </p>
          <button
            className="save-btn"
            onClick={handleCreate}
            disabled={creating}
            style={{ padding: "14px 30px", fontSize: "15px" }}
          >
            {creating ? "⏳ در حال بک‌آپ..." : "💾 گرفتن بک‌آپ جدید"}
          </button>
        </div>
      </div>

      <div className="panel">
        <div className="panel-header">
          <h2>📋 لیست بک‌آپ‌ها</h2>
          <span>{backups.length} فایل</span>
        </div>

        {loading ? (
          <div className="empty-state">
            <div>⏳</div>
            <h3>در حال بارگذاری...</h3>
          </div>
        ) : backups.length === 0 ? (
          <div className="empty-state">
            <div>💾</div>
            <h3>هنوز بک‌آپی گرفته نشده</h3>
            <p>با دکمه بالا اولین بک‌آپ رو بگیر.</p>
          </div>
        ) : (
          <div className="orders-table-wrapper">
            <table className="orders-table">
              <thead>
                <tr>
                  <th>ردیف</th>
                  <th>نام فایل</th>
                  <th>حجم</th>
                  <th>تاریخ</th>
                  <th>عملیات</th>
                </tr>
              </thead>
              <tbody>
                {backups.map((b, index) => (
                  <tr key={b.name}>
                    <td>{index + 1}</td>
                    <td>
                      <span className="customer-name">{b.name}</span>
                    </td>
                    <td>
                      <span className="weight-badge">{formatSize(b.size)}</span>
                    </td>
                    <td>
                      <span className="date-badge">
                        📅 {toPersianDate(new Date(b.date).toISOString().split("T")[0])}
                      </span>
                    </td>
                    <td>
                      <div className="row-actions">
                        <button
                          className="row-btn edit-btn"
                          onClick={() => handleDownload(b.name)}
                          title="دانلود"
                        >
                          ⬇️
                        </button>
                        <button
                          className="row-btn delete-btn"
                          onClick={() => handleDelete(b.name)}
                          title="حذف"
                        >
                          🗑️
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </>
  )
}
/* =========================
   TICKET PAGE (کاربر)
========================= */

function TicketPage({ currentUser, showToast, setPage, handleLogout, darkMode, setDarkMode }) {
  const [tickets, setTickets] = useState([])
  const [loading, setLoading] = useState(false)
  const [showNewForm, setShowNewForm] = useState(false)
  const [selectedTicket, setSelectedTicket] = useState(null)

  const [form, setForm] = useState({ subject: "", message: "" })
  const [replyText, setReplyText] = useState("")

const loadTickets = () => {
    setLoading(true)
    authFetch("/api/my-tickets")
      .then((res) => res.json())
      .then((data) => {
        setTickets(Array.isArray(data) ? data : (data?.tickets || []))
        setLoading(false)
      })
      .catch((err) => {
        console.error(err)
        setLoading(false)
      })
  }

  useEffect(() => {
    loadTickets()
  }, [])

  const handleSubmit = async (e) => {
    e.preventDefault()

    if (!form.subject.trim() || !form.message.trim()) {
      showToast("موضوع و متن رو پر کن", "warning")
      return
    }

    try {
      const response = await authFetch("/api/tickets", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(form)
      })
      const data = await response.json()

      if (data.success) {
        showToast("تیکت ارسال شد", "success")
        setForm({ subject: "", message: "" })
        setShowNewForm(false)
        loadTickets()
      } else {
        showToast(data.message || "خطا", "error")
      }
    } catch (error) {
      console.error(error)
      showToast("خطا در ارتباط با سرور", "error")
    }
  }

  const handleOpenTicket = (ticketId) => {
    authFetch(`/api/tickets/${ticketId}`)
      .then((res) => res.json())
      .then((data) => setSelectedTicket(data))
      .catch((err) => console.error(err))
  }

  const handleReply = async () => {
    if (!replyText.trim()) return

    try {
      const response = await authFetch(
        `/api/tickets/${selectedTicket.id}/reply`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message: replyText })
        }
      )
      const data = await response.json()

      if (data.success) {
        setReplyText("")
        handleOpenTicket(selectedTicket.id)
        loadTickets()
      }
    } catch (error) {
      console.error(error)
    }
  }

  const getStatusBadge = (status) => {
    if (status === "open") return { text: "🟢 باز", class: "status-approved" }
    return { text: "⚪ بسته", class: "status-pending" }
  }

  return (
    <>
      <header className="topbar">
        <div>
          <h1>🎫 تیکت‌های من</h1>
          <p>ارسال و پیگیری درخواست‌ها به مدیر</p>
        </div>
             
      </header>

      {/* دکمه تیکت جدید */}
      <div className="panel">
        <div className="panel-header">
          <h2>📝 تیکت جدید</h2>
          <button
            className="save-btn"
            onClick={() => setShowNewForm(!showNewForm)}
            style={{ padding: "8px 16px", fontSize: "13px" }}
          >
            {showNewForm ? "بستن" : "➕ ارسال تیکت جدید"}
          </button>
        </div>

        {showNewForm && (
          <form onSubmit={handleSubmit} style={{ padding: "20px" }}>
            <div className="form-group">
              <label>موضوع</label>
              <input
                type="text"
                value={form.subject}
                onChange={(e) => setForm({ ...form, subject: e.target.value })}
                placeholder="موضوع تیکت"
                required
              />
            </div>

            <div className="form-group" style={{ marginTop: "15px" }}>
              <label>متن پیام</label>
              <textarea
                value={form.message}
                onChange={(e) => setForm({ ...form, message: e.target.value })}
                placeholder="متن پیام..."
                rows={5}
                required
              ></textarea>
            </div>

            <div className="form-actions" style={{ marginTop: "20px" }}>
              <button type="button" className="cancel-btn" onClick={() => setShowNewForm(false)}>
                انصراف
              </button>
              <button type="submit" className="save-btn">
                📤 ارسال تیکت
              </button>
            </div>
          </form>
        )}
      </div>

      {/* لیست تیکت‌ها */}
      <div className="panel">
        <div className="panel-header">
          <h2>📋 تیکت‌های من</h2>
          <span>{tickets.length} تیکت</span>
        </div>

        {loading ? (
          <div className="empty-state">
            <div>⏳</div>
            <h3>در حال بارگذاری...</h3>
          </div>
        ) : tickets.length === 0 ? (
          <div className="empty-state">
            <div>🎫</div>
            <h3>هنوز تیکتی نداری</h3>
            <p>با دکمه بالا اولین تیکتت رو ارسال کن.</p>
          </div>
        ) : (
          <div className="shipments-list">
            {tickets.map((t) => {
              const badge = getStatusBadge(t.status)
              return (
                <div
                  className="shipment-card"
                  key={t.id}
                  onClick={() => handleOpenTicket(t.id)}
                  style={{ cursor: "pointer" }}
                >
                  <div className="shipment-card-header">
                    <div>
                      <strong>{t.subject}</strong>
                      <small style={{ display: "block", marginTop: "5px", color: "#6b7280" }}>
                        📅 {toPersianDate(t.created_at?.split("T")[0])}
                      </small>
                    </div>
                    <span className={`status-badge ${badge.class}`}>
                      {badge.text}
                    </span>
                  </div>

                  <div style={{ marginTop: "10px", color: "#6b7280", fontSize: "13px" }}>
                    💬 {t.replies_count} پاسخ
                  </div>
                </div>
              )
            })}
          </div>
        )}
      </div>

      {/* مودال جزئیات تیکت */}
      {selectedTicket && (
        <div className="modal-overlay" onClick={() => setSelectedTicket(null)}>
          <div
            className="modal-box"
            onClick={(e) => e.stopPropagation()}
            style={{ maxWidth: "700px", maxHeight: "90vh", overflowY: "auto" }}
          >
            <div className="modal-header">
              <h2>🎫 {selectedTicket.subject}</h2>
              <button className="modal-close" onClick={() => setSelectedTicket(null)}>✕</button>
            </div>

            <div style={{ padding: "20px" }}>
              {/* پیام اصلی */}
              <div style={{
                padding: "15px",
                background: "#f9fafb",
                borderRadius: "10px",
                marginBottom: "20px"
              }}>
                <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "10px" }}>
                  <strong>👤 {selectedTicket.user_name}</strong>
                  <small>{toPersianDate(selectedTicket.created_at?.split("T")[0])}</small>
                </div>
                <p style={{ margin: 0, lineHeight: "1.8" }}>{selectedTicket.message}</p>
              </div>

              {/* پاسخ‌ها */}
              {selectedTicket.replies?.length > 0 && (
                <div style={{ marginBottom: "20px" }}>
                  <h4 style={{ marginBottom: "10px" }}>💬 پاسخ‌ها:</h4>
                  {selectedTicket.replies.map((r) => (
                    <div
                      key={r.id}
                      style={{
                        padding: "12px 15px",
                        background: r.is_admin ? "#dbeafe" : "#f3f4f6",
                        borderRadius: "10px",
                        marginBottom: "10px",
                        borderRight: r.is_admin ? "4px solid #3b82f6" : "4px solid #9ca3af"
                      }}
                    >
                      <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "8px" }}>
                        <strong>
                          {r.is_admin ? "👑 مدیر" : "👤 " + r.user_name}
                        </strong>
                        <small>{toPersianDate(r.created_at?.split("T")[0])}</small>
                      </div>
                      <p style={{ margin: 0, lineHeight: "1.8" }}>{r.message}</p>
                    </div>
                  ))}
                </div>
              )}

              {/* فرم پاسخ (اگه تیکت بازه) */}
              {selectedTicket.status === "open" ? (
                <div>
                  <h4 style={{ marginBottom: "10px" }}>✍️ پاسخ بده:</h4>
                  <textarea
                    value={replyText}
                    onChange={(e) => setReplyText(e.target.value)}
                    placeholder="متن پاسخ..."
                    rows={3}
                    style={{
                      width: "100%",
                      padding: "12px",
                      borderRadius: "10px",
                      border: "1.5px solid #e5e7eb",
                      fontFamily: "inherit",
                      marginBottom: "10px"
                    }}
                  ></textarea>
                  <button
                    className="save-btn"
                    onClick={handleReply}
                    style={{ padding: "10px 20px" }}
                  >
                    📤 ارسال پاسخ
                  </button>
                </div>
              ) : (
                <div style={{
                  padding: "15px",
                  background: "#fef3c7",
                  borderRadius: "10px",
                  textAlign: "center"
                }}>
                  ⚪ این تیکت بسته شده
                </div>
              )}
            </div>
          </div>
        </div>
      )}
    </>
  )
}


/* =========================
   TICKETS ADMIN PAGE (مدیر)
========================= */

function TicketsAdminPage({ currentUser, showToast, setPage, handleLogout, darkMode, setDarkMode }) {
  const [tickets, setTickets] = useState([])
  const [loading, setLoading] = useState(false)
  const [selectedTicket, setSelectedTicket] = useState(null)
  const [replyText, setReplyText] = useState("")

  const loadTickets = () => {
    setLoading(true)
    authFetch("/api/tickets")
      .then((res) => res.json())
      .then((data) => {
        setTickets(data)
        setLoading(false)
      })
      .catch((err) => {
        console.error(err)
        setLoading(false)
      })
  }

  useEffect(() => {
    loadTickets()
  }, [])

  const handleOpenTicket = (ticketId) => {
    authFetch(`/api/tickets/${ticketId}`)
      .then((res) => res.json())
      .then((data) => setSelectedTicket(data))
      .catch((err) => console.error(err))
  }

  const handleReply = async () => {
    if (!replyText.trim()) return

    try {
      const response = await authFetch(
        `/api/tickets/${selectedTicket.id}/reply`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message: replyText })
        }
      )
      const data = await response.json()

      if (data.success) {
        setReplyText("")
        handleOpenTicket(selectedTicket.id)
        loadTickets()
      }
    } catch (error) {
      console.error(error)
    }
  }

  const handleClose = async () => {
    try {
      await authFetch(`/api/tickets/${selectedTicket.id}/close`, {
        method: "PUT"
      })
      showToast("تیکت بسته شد", "success")
      handleOpenTicket(selectedTicket.id)
      loadTickets()
    } catch (error) {
      console.error(error)
    }
  }

  const handleReopen = async () => {
    try {
      await authFetch(`/api/tickets/${selectedTicket.id}/reopen`, {
        method: "PUT"
      })
      showToast("تیکت باز شد", "success")
      handleOpenTicket(selectedTicket.id)
      loadTickets()
    } catch (error) {
      console.error(error)
    }
  }

  const getStatusBadge = (status) => {
    if (status === "open") return { text: "🟢 باز", class: "status-approved" }
    return { text: "⚪ بسته", class: "status-pending" }
  }

  return (
    <>
      <header className="topbar">
        <div>
          <h1>🎫 مدیریت تیکت‌ها</h1>
          <p>مشاهده و پاسخ به تیکت‌های کاربران</p>
        </div>
              
      </header>

      <div className="panel">
        <div className="panel-header">
          <h2>📋 همه تیکت‌ها</h2>
          <span>{tickets.length} تیکت</span>
        </div>

        {loading ? (
          <div className="empty-state">
            <div>⏳</div>
            <h3>در حال بارگذاری...</h3>
          </div>
        ) : tickets.length === 0 ? (
          <div className="empty-state">
            <div>🎫</div>
            <h3>هنوز تیکتی ارسال نشده</h3>
          </div>
        ) : (
          <div className="orders-table-wrapper">
            <table className="orders-table">
              <thead>
                <tr>
                  <th>ردیف</th>
                  <th>موضوع</th>
                  <th>کاربر</th>
                  <th>پاسخ‌ها</th>
                  <th>وضعیت</th>
                  <th>تاریخ</th>
                  <th>عملیات</th>
                </tr>
              </thead>
              <tbody>
                {tickets.map((t, index) => {
                  const badge = getStatusBadge(t.status)
                  return (
                    <tr key={t.id}>
                      <td>{index + 1}</td>
                      <td>
                        <span className="customer-name">{t.subject}</span>
                      </td>
                      <td>{t.user_name}</td>
                      <td>
                        <span className="weight-badge">{t.replies_count} پاسخ</span>
                      </td>
                      <td>
                        <span className={`status-badge ${badge.class}`}>{badge.text}</span>
                      </td>
                      <td>
                        <span className="date-badge">
                          📅 {toPersianDate(t.created_at?.split("T")[0])}
                        </span>
                      </td>
                      <td>
                        <button
                          className="save-btn"
                          style={{ padding: "6px 14px", fontSize: "12px" }}
                          onClick={() => handleOpenTicket(t.id)}
                        >
                          👁️ مشاهده
                        </button>
                      </td>
                    </tr>
                  )
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>

      {/* مودال جزئیات */}
      {selectedTicket && (
        <div className="modal-overlay" onClick={() => setSelectedTicket(null)}>
          <div
            className="modal-box"
            onClick={(e) => e.stopPropagation()}
            style={{ maxWidth: "700px", maxHeight: "90vh", overflowY: "auto" }}
          >
            <div className="modal-header">
              <h2>🎫 {selectedTicket.subject}</h2>
              <button className="modal-close" onClick={() => setSelectedTicket(null)}>✕</button>
            </div>

            <div style={{ padding: "20px" }}>
              {/* پیام اصلی */}
              <div style={{
                padding: "15px",
                background: "#f9fafb",
                borderRadius: "10px",
                marginBottom: "20px"
              }}>
                <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "10px" }}>
                  <strong>👤 {selectedTicket.user_name}</strong>
                  <small>{toPersianDate(selectedTicket.created_at?.split("T")[0])}</small>
                </div>
                <p style={{ margin: 0, lineHeight: "1.8" }}>{selectedTicket.message}</p>
              </div>

              {/* پاسخ‌ها */}
              {selectedTicket.replies?.length > 0 && (
                <div style={{ marginBottom: "20px" }}>
                  <h4 style={{ marginBottom: "10px" }}>💬 پاسخ‌ها:</h4>
                  {selectedTicket.replies.map((r) => (
                    <div
                      key={r.id}
                      style={{
                        padding: "12px 15px",
                        background: r.is_admin ? "#dbeafe" : "#f3f4f6",
                        borderRadius: "10px",
                        marginBottom: "10px",
                        borderRight: r.is_admin ? "4px solid #3b82f6" : "4px solid #9ca3af"
                      }}
                    >
                      <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "8px" }}>
                        <strong>
                          {r.is_admin ? "👑 مدیر" : "👤 " + r.user_name}
                        </strong>
                        <small>{toPersianDate(r.created_at?.split("T")[0])}</small>
                      </div>
                      <p style={{ margin: 0, lineHeight: "1.8" }}>{r.message}</p>
                    </div>
                  ))}
                </div>
              )}

              {/* فرم پاسخ */}
              {selectedTicket.status === "open" && (
                <div style={{ marginBottom: "20px" }}>
                  <h4 style={{ marginBottom: "10px" }}>✍️ پاسخ بده:</h4>
                  <textarea
                    value={replyText}
                    onChange={(e) => setReplyText(e.target.value)}
                    placeholder="متن پاسخ..."
                    rows={3}
                    style={{
                      width: "100%",
                      padding: "12px",
                      borderRadius: "10px",
                      border: "1.5px solid #e5e7eb",
                      fontFamily: "inherit",
                      marginBottom: "10px"
                    }}
                  ></textarea>
                  <button
                    className="save-btn"
                    onClick={handleReply}
                    style={{ padding: "10px 20px" }}
                  >
                    📤 ارسال پاسخ
                  </button>
                </div>
              )}

              {/* دکمه بستن/بازکردن */}
              <div style={{ display: "flex", gap: "10px", marginTop: "20px" }}>
                {selectedTicket.status === "open" ? (
                  <button className="confirm-delete-btn" onClick={handleClose}>
                    🔒 بستن تیکت
                  </button>
                ) : (
                  <button className="save-btn" onClick={handleReopen}>
                    🔓 باز کردن دوباره
                  </button>
                )}
              </div>
            </div>
          </div>
        </div>
      )}
    </>
  )
}
